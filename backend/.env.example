# ─── iTOP Connection ──────────────────────────────────────────
# URL base del webservice REST de iTOP
ITOP_URL=https://tudominio/itop/webservices/rest.php
# Versión del API (1.3 o 1.4)
ITOP_VERSION=1.4
# Usuario con perfil "REST Services User"
ITOP_USER=tu_usuario_api
ITOP_PASSWORD=tu_password_api

# ─── Tu identidad en iTOP ─────────────────────────────────────
# Buscalo en iTOP → Contacts → Persons → tu nombre
# O consultando: SELECT Person WHERE email like '%@tudominio%'
AGENT_ID=42
AGENT_NAME=TuNombre

# ─── Team ID ──────────────────────────────────────────────────
# ID del equipo en iTOP para filtrar tickets del grupo
TEAM_ID=1

# ─── WIP (Work In Progress) Limit ─────────────────────────────
# Máximo de tickets abiertos por persona antes de marcar "cuello de botella"
WIP_MAX_PER_AGENT=6

# ─── Backend ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Intervalo de refresco en segundos
REFRESH_INTERVAL_SECONDS=30
