# ─── iTOP Connection ──────────────────────────────────────────
# URL base del webservice REST de iTOP
ITOP_URL=https://tudominio/itop/webservices/rest.php
# Versión del API (1.3 o 1.4)
ITOP_VERSION=1.4
# Usuario con perfil "REST Services User"
ITOP_USER=tu_usuario_api
# 🔐 La contraseña se guarda en el Credential Manager del SO.
#    Ejecutá: python store_password.py
#    Alternativa (NO RECOMENDADA): ponerla acá como ITOP_PASSWORD_SECRET=pass
ITOP_PASSWORD_SECRET=

# ─── Tu identidad en iTOP ─────────────────────────────────────
# Se puede descubrir automáticamente dejando vacío
AGENT_ID=
AGENT_NAME=

# ─── Team ID ──────────────────────────────────────────────────
TEAM_ID=

# ─── WIP (Work In Progress) Limit ─────────────────────────────
WIP_MAX_PER_AGENT=6

# ─── Backend ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
REFRESH_INTERVAL_SECONDS=30
